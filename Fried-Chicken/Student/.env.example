# Copy this file to `.env` and fill in the two values below.
# `.env` is gitignored — never commit it, this repository is public.
#
# Ask a teammate for the real values, or read them from the Supabase
# dashboard: Project Settings -> API.
#
#   NEXT_PUBLIC_SUPABASE_URL              Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  the anon / publishable key
#
# Both are safe to expose in the browser (that's what NEXT_PUBLIC_ means) —
# row-level security is what actually protects the data. Keep them out of
# the repo anyway: combined with the demo passwords in README.md they would
# let anyone sign in to our project as an admin.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
